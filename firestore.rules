rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Strict administrator authorization:
    // Requires authenticated Google user whose normalized email is the designated administrator
    // (swati.soam@primipassiedu.com) OR an authorized administrator record exists in /admins/{uid}.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'swati.soam@primipassiedu.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection health check route
    match /test/{testId} {
      allow read: if true;
    }

    // Public catalog content (Read by anyone, written only by authorized Admins)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /treatments/{treatmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whyIndia/{pointId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /journeySteps/{stepId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Patient enquiries: Anyone can submit a consultation lead;
    // Only authorized Admins can read, inspect documents, update, and delete patient records!
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Administrator role records:
    // Read: authenticated users can read their own record or admins can read
    // Write: strictly authorized admin only
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
